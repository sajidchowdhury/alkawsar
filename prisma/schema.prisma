generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id        String         @id @default(cuid())
  slug      String         @unique
  nameBn    String
  nameEn    String
  gradeBn   String
  descBn    String
  category  String         @default("dates")
  stock     String         @default("available")
  sortOrder Int            @default(0)
  updatedAt DateTime       @updatedAt
  prices    ProductPrice[]
  history   PriceHistory[]
}

model ProductPrice {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  tierId    String
  price     Int
  updatedAt DateTime @updatedAt

  @@unique([productId, tierId])
}

model PriceHistory {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  tierId    String
  oldPrice  Int
  newPrice  Int
  createdAt DateTime @default(now())

  @@index([productId, tierId])
}

model SiteMeta {
  id          String   @id @default("main")
  noteBn      String   @default("")
  seedVersion Int      @default(0)
  updatedAt   DateTime @updatedAt
}
