# AL-KAWSAR environment template
# Copy to .env and adjust for your machine:  cp .env.example .env

# SQLite database (use an ABSOLUTE path to avoid ambiguity).
# Example below assumes the project lives at /var/www/alkawsar — adjust to your folder.
DATABASE_URL=file:/var/www/alkawsar/db/custom.db

# Sub-path deployment. Keep as /alkawsar when hosting at https://inventoryos.xyz/alkawsar
# (must be set BEFORE `npm run build`; it is baked into the client bundle).
NEXT_PUBLIC_BASE_PATH=/alkawsar

# Owner admin panel credentials (change before going live)
ADMIN_PASSWORD=change-this-password
ADMIN_SECRET=change-this-secret
